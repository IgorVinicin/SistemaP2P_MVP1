# Copie para .env; preencha valores exclusivos. Nenhuma chave real deve ser versionada.
JWT_KEY=
ConnectionStrings__DefaultConnection=
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_ACCESS_TOKEN=
# CORS da aplicação implantada (índice 0, 1, ...).
Cors__AllowedOrigins__0=http://localhost:4200
# Opcional: cria administrador inicial somente se ainda não houver administrador.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Dados fictícios somente em Development e mediante autorização explícita.
Seed__DemoData=false
